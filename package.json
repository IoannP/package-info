{
  "name": "package-info",
  "displayName": "Package info",
  "description": "This extension provides information about imported packages directly in your code editor.",
  "version": "2.0.1",
  "publisher": "IoannP",
  "author": {
    "name": "Ioann Pilipchuk",
    "email": "iopilipchuk@gmail.com"
  },
  "repository": {
    "url": "https://github.com/IoannP/package-info.git",
    "type": "git"
  },
  "license": "MIT",
  "engines": {
    "vscode": ">=1.103.0",
    "node": ">=16"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "info",
    "package",
    "npm",
    "view",
    "link",
    "homepage"
  ],
  "icon": "assets/logo.png",
  "galleryBanner": {
    "color": "#bbbbbf",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:python",
    "onLanguage:svelte",
    "onLanguage:vue"
  ],
  "main": "./dist/extension.mjs",
  "type": "module",
  "scripts": {
    "compile": "tsc -p ./",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.1",
    "@types/vscode": "^1.103.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "nock": "^14.0.9",
    "typescript-eslint": "^8.39.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "toml": "^3.0.0",
    "yaml": "^2.8.1"
  }
}
