{
  "include": ["src"],
	"compilerOptions": {
		"module": "NodeNext",
		"target": "esnext",
		"outDir": "dist",
		"lib": [
			"ESNext"
		],
    "types": ["node", "vscode"],
		"sourceMap": false,
		"rootDir": "src",
		"strict": true,
		"noUnusedParameters": true,
    "allowUnreachableCode": false
	}
}
